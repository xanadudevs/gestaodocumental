generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite para começar sem infraestrutura. Para produção com vários
  // utilizadores em simultâneo, muda para "postgresql" e aponta
  // DATABASE_URL para uma instância grátis (ex: Neon ou Supabase).
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite não suporta enums nativos no Prisma, por isso os "enums" abaixo
// são strings validadas na aplicação (ver src/lib/enums.ts). Ao migrar
// para PostgreSQL podes converter estes campos para `enum` reais.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER") // Role: ADMIN | APPROVER | USER
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  uploadedDocuments  Document[] @relation("UploadedBy")
  approvalsAssigned  Document[] @relation("AssignedApprover")
  comments           Comment[]
  auditLogs          AuditLog[]
}

model Document {
  id             String         @id @default(cuid())
  title          String
  description    String?
  type           String         @default("OTHER") // DocumentType: INVOICE | EMAIL | CONTRACT | OTHER
  status         String         @default("DRAFT")  // DocumentStatus: DRAFT | PENDING | APPROVED | REJECTED

  fileName String
  filePath String
  fileSize Int
  mimeType String

  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id])
  uploadedById String

  approver   User?   @relation("AssignedApprover", fields: [approverId], references: [id])
  approverId String?

  decisionReason String?
  submittedAt    DateTime?
  decidedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  Comment[]
  auditLogs AuditLog[]

  @@index([status])
  @@index([approverId])
  @@index([uploadedById])
}

model Comment {
  id         String   @id @default(cuid())
  body       String
  createdAt  DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  @@index([documentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // AuditAction: UPLOADED | SUBMITTED | APPROVED | REJECTED | COMMENTED | REASSIGNED
  meta      String?
  createdAt DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  actor   User   @relation(fields: [actorId], references: [id])
  actorId String

  @@index([documentId])
}

// --- Modelos padrão do NextAuth ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
