generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL grátis (ex: Supabase). DATABASE_URL usa a ligação com
  // pooling (porta 6543, boa para serverless/Vercel); DIRECT_URL usa a
  // ligação direta (porta 5432), necessária para migrações.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Os "enums" abaixo são strings validadas na aplicação (ver
// src/lib/enums.ts) em vez de enums nativos do Prisma, para simplificar.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique // login local por username/password (alternativa ao OAuth)
  passwordHash  String? // bcrypt - nunca guardar em texto simples
  role          String    @default("USER") // Role: ADMIN | APPROVER | SUPPORT | USER
  level         String? // Level: TECNICO | GESTAO | COORDENACAO | DIRECAO | CONSELHO
  createdAt     DateTime  @default(now())

  unit   Unit?   @relation(fields: [unitId], references: [id])
  unitId String?

  accounts Account[]
  sessions Session[]

  uploadedDocuments Document[] @relation("UploadedBy")
  approvalsAssigned Document[] @relation("AssignedApprover")
  comments          Comment[]
  auditLogs         AuditLog[]

  licenseRequestsMade     LicenseRequest[] @relation("LicenseRequestedBy")
  licenseRequestsToDecide LicenseRequest[] @relation("LicenseCoordinator")
  licenseEvents           LicenseEvent[]

  @@index([unitId])
}

// Estrutura organizacional (Direções, Unidades, etc.), em árvore.
model Unit {
  id       String  @id @default(cuid())
  name     String
  order    Int     @default(0)
  parent   Unit?   @relation("UnitHierarchy", fields: [parentId], references: [id])
  parentId String?
  children Unit[]  @relation("UnitHierarchy")
  users    User[]

  licenseRequestsCoordination LicenseRequest[] @relation("LicenseCoordination")
  licenseRequestsDirection    LicenseRequest[] @relation("LicenseDirection")

  @@index([parentId])
}

model Document {
  id          String  @id @default(cuid())
  title       String
  description String?
  type        String  @default("OTHER") // DocumentType: INVOICE | EMAIL | CONTRACT | OTHER
  status      String  @default("DRAFT") // DocumentStatus: DRAFT | PENDING | APPROVED | REJECTED

  fileName String
  filePath String
  fileSize Int
  mimeType String

  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id])
  uploadedById String

  approver   User?   @relation("AssignedApprover", fields: [approverId], references: [id])
  approverId String?

  decisionReason String?
  submittedAt    DateTime?
  decidedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  Comment[]
  auditLogs AuditLog[]

  @@index([status])
  @@index([approverId])
  @@index([uploadedById])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  @@index([documentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // AuditAction: UPLOADED | SUBMITTED | APPROVED | REJECTED | COMMENTED | REASSIGNED
  meta      String?
  createdAt DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  actor   User   @relation(fields: [actorId], references: [id])
  actorId String

  @@index([documentId])
}

// --- Licenciamento (pedidos de licenças de software, ex: Figma) ---

// Um pedido de licença para um beneficiário. Fluxo:
// PENDING (aguarda coordenador) -> APPROVED (aguarda Apoio Administrativo)
// -> GRANTED (acesso dado) -> REVOKED (licença libertada).
// PENDING -> REJECTED se o coordenador rejeitar.
model LicenseRequest {
  id          String @id @default(cuid())
  product     String // LicenseProduct: FIGMA
  licenseType String // LicenseType: FULL | VIEW
  status      String @default("PENDING") // LicenseStatus: PENDING | APPROVED | REJECTED | GRANTED | REVOKED

  // Beneficiário (pode ser diferente de quem fez o pedido)
  beneficiaryName  String
  beneficiaryEmail String // email profissional
  jobTitle         String?
  superiorName     String
  superiorEmail    String
  justification    String
  project          String?

  coordination   Unit   @relation("LicenseCoordination", fields: [coordinationId], references: [id])
  coordinationId String
  // Direção a que a licença conta para o limite (guardada no pedido para
  // o histórico não mudar se o organigrama mudar)
  direction      Unit   @relation("LicenseDirection", fields: [directionId], references: [id])
  directionId    String

  requestedBy   User   @relation("LicenseRequestedBy", fields: [requestedById], references: [id])
  requestedById String

  coordinator   User   @relation("LicenseCoordinator", fields: [coordinatorId], references: [id])
  coordinatorId String

  decisionReason String?
  decidedAt      DateTime?
  grantedAt      DateTime?
  revokedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events LicenseEvent[]

  @@index([status])
  @@index([directionId, product])
  @@index([coordinatorId])
  @@index([beneficiaryEmail])
}

model LicenseEvent {
  id        String   @id @default(cuid())
  action    String // LicenseAction: REQUESTED | APPROVED | REJECTED | GRANTED | REVOKED | EMAIL_FAILED
  meta      String?
  createdAt DateTime @default(now())

  request   LicenseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String

  actor   User   @relation(fields: [actorId], references: [id])
  actorId String

  @@index([requestId])
}

// --- Modelos padrão do NextAuth ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
