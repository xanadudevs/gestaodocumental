generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL grátis (ex: Supabase). DATABASE_URL usa a ligação com
  // pooling (porta 6543, boa para serverless/Vercel); DIRECT_URL usa a
  // ligação direta (porta 5432), necessária para migrações.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Os "enums" abaixo são strings validadas na aplicação (ver
// src/lib/enums.ts) em vez de enums nativos do Prisma, para simplificar.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique // login local por username/password (alternativa ao OAuth)
  passwordHash  String? // bcrypt - nunca guardar em texto simples
  role          String    @default("USER") // Role: ADMIN | APPROVER | SUPPORT | USER
  level         String? // Level: TECNICO | GESTAO | COORDENACAO | DIRECAO | CONSELHO
  createdAt     DateTime  @default(now())

  unit   Unit?   @relation(fields: [unitId], references: [id])
  unitId String?

  accounts Account[]
  sessions Session[]

  uploadedDocuments Document[]           @relation("UploadedBy")
  approvalsAssigned Document[]           @relation("AssignedApprover")
  documentsHeld     Document[]           @relation("DocumentHolder")
  attachments       DocumentAttachment[]
  auditTargets      AuditLog[]           @relation("AuditTarget")
  comments          Comment[]
  auditLogs         AuditLog[]

  licenseRequestsMade     LicenseRequest[] @relation("LicenseRequestedBy")
  licenseRequestsToDecide LicenseRequest[] @relation("LicenseCoordinator")
  licenseEvents           LicenseEvent[]

  @@index([unitId])
}

// Estrutura organizacional (Direções, Unidades, etc.), em árvore.
model Unit {
  id       String  @id @default(cuid())
  name     String
  order    Int     @default(0)
  parent   Unit?   @relation("UnitHierarchy", fields: [parentId], references: [id])
  parentId String?
  children Unit[]  @relation("UnitHierarchy")
  users    User[]

  documents                   Document[]       @relation("DocumentUnit")
  licenseRequestsCoordination LicenseRequest[] @relation("LicenseCoordination")
  licenseRequestsDirection    LicenseRequest[] @relation("LicenseDirection")

  @@index([parentId])
}

model Document {
  id          String  @id @default(cuid())
  // Referência, ex: 01/DANAD - UPACE/2026 (ver src/lib/references.ts). É
  // única porque vem do contador atómico por unidade/ano (DocumentCounter);
  // não tem @unique para o db push do build não pedir --accept-data-loss.
  reference   String?
  title       String // Assunto
  description String?
  // DocumentType: INVOICE | EMAIL | OFICIO_IN | EXTERNAL | INFORMACAO | OFICIO | OTHER
  type        String  @default("OTHER")
  // DocumentFlow: IN (entrada: chega à Direção) | OUT (saída: informação/ofício feito cá)
  flow        String  @default("IN")
  // Entrada: RECEIVED | IN_PROGRESS | CLOSED
  // Saída:   DRAFT | IN_REVIEW | RETURNED | APPROVED | SENT
  // (PENDING | APPROVED | REJECTED | DRAFT dos documentos antigos continuam válidos)
  status      String  @default("DRAFT")

  // Entrada: de onde vem (Direção Financeira, Conselho de Administração, ...)
  origin      String?
  // Saída: para quem vai (Conselho de Administração, outra direção, entidade externa)
  destination String?
  // Referência externa (V/Refª)
  externalRef String?
  receivedAt  DateTime?
  sentAt      DateTime?

  // Unidade dona da numeração (entradas: a Direção; saídas: quem emite)
  unit   Unit?   @relation("DocumentUnit", fields: [unitId], references: [id])
  unitId String?

  // Campos do formulário (informação/ofício), usados para gerar o Word
  formData Json?

  // Análise por IA (entradas): resumo, urgência (BAIXA|NORMAL|ALTA) e etiquetas
  aiSummary String?
  aiUrgency String?
  aiTags    String[] @default([])

  // Ficheiro principal (documentos antigos); os novos usam anexos
  fileName String?
  filePath String?
  fileSize Int?
  mimeType String?

  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id])
  uploadedById String

  // Quem tem o documento agora ("Na minha caixa")
  holder   User?   @relation("DocumentHolder", fields: [holderId], references: [id])
  holderId String?

  approver   User?   @relation("AssignedApprover", fields: [approverId], references: [id])
  approverId String?

  decisionReason String?
  submittedAt    DateTime?
  decidedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments    Comment[]
  auditLogs   AuditLog[]
  attachments DocumentAttachment[]

  @@index([status])
  @@index([approverId])
  @@index([holderId])
  @@index([uploadedById])
  @@index([flow, type])
  @@index([reference])
}

model DocumentAttachment {
  id        String   @id @default(cuid())
  fileName  String
  filePath  String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String

  @@index([documentId])
}

// Contador da numeração por unidade e ano (01, 02, ...)
model DocumentCounter {
  unitId String
  year   Int
  last   Int    @default(0)

  @@id([unitId, year])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  @@index([documentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  // AuditAction: UPLOADED | SUBMITTED | APPROVED | REJECTED | COMMENTED | REASSIGNED
  //   | REGISTERED | CREATED | FORWARDED | OPINION | RETURNED | CLOSED | SENT | EDITED | ATTACHED
  action    String
  meta      String? // texto: despacho, parecer, motivo, ...
  createdAt DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  actor   User   @relation(fields: [actorId], references: [id])
  actorId String

  // Para quem foi (encaminhamento, parecer, submissão)
  target   User?   @relation("AuditTarget", fields: [targetId], references: [id])
  targetId String?

  @@index([documentId])
}

// --- Licenciamento (pedidos de licenças de software, ex: Figma) ---

// Um pedido de licença para um beneficiário. Fluxo:
// PENDING (aguarda coordenador) -> APPROVED (aguarda Apoio Administrativo)
// -> GRANTED (acesso dado) -> REVOKED (licença libertada).
// PENDING -> REJECTED se o coordenador rejeitar.
model LicenseRequest {
  id          String @id @default(cuid())
  product     String // LicenseProduct: FIGMA
  licenseType String // LicenseType: FULL | VIEW
  status      String @default("PENDING") // LicenseStatus: PENDING | APPROVED | REJECTED | GRANTED | REVOKED

  // Beneficiário (pode ser diferente de quem fez o pedido)
  beneficiaryName  String
  beneficiaryEmail String // email profissional
  jobTitle         String?
  // Gestor de Projeto (no formulário). Os campos mantêm o nome antigo.
  superiorName     String
  superiorEmail    String
  justification    String
  project          String?

  coordination   Unit   @relation("LicenseCoordination", fields: [coordinationId], references: [id])
  coordinationId String
  // Direção a que a licença conta para o limite (guardada no pedido para
  // o histórico não mudar se o organigrama mudar)
  direction      Unit   @relation("LicenseDirection", fields: [directionId], references: [id])
  directionId    String

  // Vazio quando o pedido foi feito no formulário público (sem login)
  requestedBy   User?   @relation("LicenseRequestedBy", fields: [requestedById], references: [id])
  requestedById String?

  coordinator   User   @relation("LicenseCoordinator", fields: [coordinatorId], references: [id])
  coordinatorId String

  decisionReason String?
  decidedAt      DateTime?
  grantedAt      DateTime?
  revokedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events LicenseEvent[]

  @@index([status])
  @@index([directionId, product])
  @@index([coordinatorId])
  @@index([beneficiaryEmail])
}

model LicenseEvent {
  id        String   @id @default(cuid())
  action    String // LicenseAction: REQUESTED | APPROVED | REJECTED | GRANTED | REVOKED | EMAIL_FAILED
  meta      String?
  createdAt DateTime @default(now())

  request   LicenseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String

  // Vazio em ações sem login (pedido feito no formulário público)
  actor   User?   @relation(fields: [actorId], references: [id])
  actorId String?

  @@index([requestId])
}

// --- Modelos padrão do NextAuth ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
