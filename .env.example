# Base de dados (SQLite local para começar - grátis e sem infraestrutura)
DATABASE_URL="file:./dev.db"

# NextAuth
# Gera um valor com: openssl rand -base64 32
NEXTAUTH_SECRET="troca-me-por-um-valor-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft / Azure AD OAuth (https://portal.azure.com -> App registrations)
# Redirect URI: http://localhost:3000/api/auth/callback/azure-ad
# AZURE_AD_TENANT_ID pode ser "common" para aceitar contas pessoais e de trabalho/escola
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"
