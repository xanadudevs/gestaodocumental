# Base de dados PostgreSQL do Supabase (Project Settings -> Database)
# DATABASE_URL = "Connection pooling" (porta 6543) - usada em runtime
# DIRECT_URL   = "Connection string" direta (porta 5432) - usada só para migrações
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xxxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xxxxx.pooler.supabase.com:5432/postgres"

# Supabase Storage (Project Settings -> API)
# Cria um bucket privado chamado "documents" em Storage -> New bucket
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documents"

# NextAuth
# Gera um valor com: openssl rand -base64 32
NEXTAUTH_SECRET="troca-me-por-um-valor-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Em produção, adiciona também: https://<o-teu-dominio>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft / Azure AD OAuth (https://portal.azure.com -> App registrations)
# Redirect URI: http://localhost:3000/api/auth/callback/azure-ad
# Em produção, adiciona também: https://<o-teu-dominio>/api/auth/callback/azure-ad
# AZURE_AD_TENANT_ID pode ser "common" para aceitar contas pessoais e de trabalho/escola
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"

# Login local por utilizador/password (acesso inicial sem OAuth). Sem
# estas duas variáveis definidas, esta opção de login fica desativada.
# Gera o hash com: node -e "console.log(require('bcryptjs').hashSync('A_TUA_PASSWORD', 10))"
# BOOTSTRAP_PASSWORD_HASH é o hash, NUNCA a password em texto simples.
# IMPORTANTE (só para ficheiros .env locais, não afeta a Vercel): o hash
# do bcrypt tem "$" no valor, e o carregador de .env do Next.js tenta
# expandir "$algo" como se fosse outra variável. Escapa cada "$" como "\$"
# neste ficheiro, ex: BOOTSTRAP_PASSWORD_HASH="\$2b\$10\$abduzhwyz...".
# Na Vercel cola o hash tal como saiu do comando acima, sem escapar nada.
BOOTSTRAP_USERNAME=""
BOOTSTRAP_PASSWORD_HASH=""

# Emails do módulo de Licenças (SMTP). Ex. Office 365: smtp.office365.com,
# porta 587, com uma caixa de correio de serviço. Sem SMTP_HOST, a app
# funciona na mesma mas os emails não são enviados (ficam só no log).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
# Email(s) do Apoio Administrativo, notificado quando um coordenador
# aprova um pedido de licença (vários separados por vírgula).
LICENSE_SUPPORT_EMAIL=""
